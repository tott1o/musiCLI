# YouTube Authentication Configuration
# Set to a browser name (e.g., 'chrome', 'firefox', 'edge') to use cookies from your browser for YouTube authentication.
# This helps in avoiding bot detection and accessing age-restricted content.
YOUTUBE_COOKIES_FROM_BROWSER=firefox

# Alternatively, specify a path to a cookies.txt file (Netscape format)
# YOUTUBE_COOKIES_FILE=./cookies.txt
